<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_lobby_status"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="viewStart" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_members_header"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/nextendo_lobby_members"
        android:textAlignment="viewStart" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_lobby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:scrollbars="vertical" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_members_empty"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/nextendo_lobby_members_empty"
        android:textAlignment="viewStart" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_recent_header"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/nextendo_lobby_recent"
        android:textAlignment="viewStart" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:scrollbars="vertical" />

</LinearLayout>
